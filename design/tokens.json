{
  "base": {
    "font": {
      "family": {
        "sans": { "$type": "fontFamilies", "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
        "mono": { "$type": "fontFamilies", "$value": ["SFMono-Regular", "Consolas", "Liberation Mono", "Menlo", "monospace"] }
      },
      "size": {
        "code": { "$type": "fontSizes", "$value": "13.6" },
        "sm": { "$type": "fontSizes", "$value": "14" },
        "base": { "$type": "fontSizes", "$value": "16" },
        "md": { "$type": "fontSizes", "$value": "17.6" },
        "lg": { "$type": "fontSizes", "$value": "18" },
        "xl": { "$type": "fontSizes", "$value": "20.8" },
        "2xl": { "$type": "fontSizes", "$value": "24" }
      },
      "weight": {
        "regular": { "$type": "fontWeights", "$value": "400" },
        "bold": { "$type": "fontWeights", "$value": "700" }
      }
    },
    "line-height": {
      "body": { "$type": "number", "$value": "1.7" },
      "heading": { "$type": "number", "$value": "1.3" },
      "heading-2": { "$type": "number", "$value": "1.556", "$description": "28px at 18px" },
      "content-heading-2": { "$type": "number", "$value": "1.346", "$description": "28px at 20.8px" },
      "code": { "$type": "number", "$value": "1.4" }
    },
    "typography": {
      "site-name": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.2xl}", "fontWeight": "{font.weight.bold}", "lineHeight": "{line-height.body}" } },
      "heading-1": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.2xl}", "fontWeight": "{font.weight.bold}", "lineHeight": "{line-height.heading}" } },
      "heading-2": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.lg}", "fontWeight": "{font.weight.bold}", "lineHeight": "{line-height.heading-2}" } },
      "content-heading-2": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.xl}", "fontWeight": "{font.weight.bold}", "lineHeight": "{line-height.content-heading-2}" } },
      "heading-3": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.md}", "fontWeight": "{font.weight.bold}", "lineHeight": "{line-height.body}" } },
      "body": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.base}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line-height.body}" } },
      "small": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.sm}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line-height.body}" } },
      "date": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.sm}", "fontWeight": "400 italic", "lineHeight": "{line-height.body}" } },
      "code": { "$type": "typography", "$value": { "fontFamilies": "{font.family.mono}", "fontSizes": "{font.size.code}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line-height.code}" } }
    },
    "space": {
      "xs": { "$type": "spacing", "$value": "8" },
      "sm": { "$type": "spacing", "$value": "12" },
      "md": { "$type": "spacing", "$value": "16" },
      "lg": { "$type": "spacing", "$value": "24" },
      "xl": { "$type": "spacing", "$value": "32" },
      "2xl": { "$type": "spacing", "$value": "40" },
      "3xl": { "$type": "spacing", "$value": "48" }
    },
    "size": {
      "content": { "$type": "sizing", "$value": "672", "$description": "Maximum width of header, main and footer" },
      "icon-link": { "$type": "sizing", "$value": "36" }
    },
    "radius": {
      "sm": { "$type": "borderRadius", "$value": "4" },
      "md": { "$type": "borderRadius", "$value": "6" },
      "full": { "$type": "borderRadius", "$value": "999" }
    },
    "color": {
      "item-title": { "$type": "color", "$value": "#155DFC" },
      "text-subtle": { "$type": "color", "$value": "#99A1AF" },
      "border-hover": { "$type": "color", "$value": "#99A1AF" },
      "pre-text": { "$type": "color", "$value": "#E5E7EB" }
    }
  },
  "light": {
    "color": {
      "background": { "$type": "color", "$value": "#FFFFFF" },
      "text": { "$type": "color", "$value": "#101828" },
      "text-secondary": { "$type": "color", "$value": "#4A5565" },
      "text-muted": { "$type": "color", "$value": "#6A7282" },
      "link": { "$type": "color", "$value": "#2563EB" },
      "border": { "$type": "color", "$value": "#E5E7EB" },
      "code-background": { "$type": "color", "$value": "#F3F4F6" },
      "pre-background": { "$type": "color", "$value": "#1F2937" },
      "quote-border": { "$type": "color", "$value": "#D1D5DB" },
      "quote-text": { "$type": "color", "$value": "#6B7280" }
    }
  },
  "dark": {
    "color": {
      "background": { "$type": "color", "$value": "#030712" },
      "text": { "$type": "color", "$value": "#F3F4F6" },
      "text-secondary": { "$type": "color", "$value": "#99A1AF" },
      "text-muted": { "$type": "color", "$value": "#99A1AF" },
      "link": { "$type": "color", "$value": "#54A2FF" },
      "border": { "$type": "color", "$value": "#1E2939" },
      "code-background": { "$type": "color", "$value": "#1E2939" },
      "pre-background": { "$type": "color", "$value": "#111827" },
      "quote-border": { "$type": "color", "$value": "#4A5565" },
      "quote-text": { "$type": "color", "$value": "#99A1AF" }
    }
  },
  "$themes": [
    { "name": "light", "group": "mode", "selectedTokenSets": { "base": "enabled", "light": "enabled" } },
    { "name": "dark", "group": "mode", "selectedTokenSets": { "base": "enabled", "dark": "enabled" } }
  ],
  "$metadata": { "tokenSetOrder": ["base", "light", "dark"] }
}
