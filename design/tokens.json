{
  "base": {
    "font": {
      "family": {
        "sans": { "$type": "fontFamilies", "$value": ["Noto Sans JP", "sans-serif"] },
        "mono": { "$type": "fontFamilies", "$value": ["Roboto Mono", "monospace"] }
      },
      "size": {
        "label": { "$type": "fontSizes", "$value": "11" },
        "meta": { "$type": "fontSizes", "$value": "12" },
        "nav": { "$type": "fontSizes", "$value": "13" },
        "code": { "$type": "fontSizes", "$value": "14" },
        "excerpt": { "$type": "fontSizes", "$value": "13.5" },
        "sm": { "$type": "fontSizes", "$value": "14" },
        "site-name": { "$type": "fontSizes", "$value": "15" },
        "base": { "$type": "fontSizes", "$value": "16" },
        "lg": { "$type": "fontSizes", "$value": "17" },
        "xl": { "$type": "fontSizes", "$value": "18" },
        "2xl": { "$type": "fontSizes", "$value": "21" },
        "3xl": { "$type": "fontSizes", "$value": "30" },
        "4xl": { "$type": "fontSizes", "$value": "32" }
      },
      "weight": {
        "light": { "$type": "fontWeights", "$value": "300" },
        "regular": { "$type": "fontWeights", "$value": "400" },
        "medium": { "$type": "fontWeights", "$value": "500" }
      }
    },
    "line-height": {
      "article": { "$type": "number", "$value": "1.95" },
      "relaxed": { "$type": "number", "$value": "1.9" },
      "normal": { "$type": "number", "$value": "1.7" },
      "compact": { "$type": "number", "$value": "1.6" },
      "heading": { "$type": "number", "$value": "1.5" },
      "code": { "$type": "number", "$value": "1.75" }
    },
    "letter-spacing": {
      "label": { "$type": "letterSpacing", "$value": "2.6" },
      "site-name": { "$type": "letterSpacing", "$value": "1.8" },
      "meta": { "$type": "letterSpacing", "$value": "1.2" },
      "nav": { "$type": "letterSpacing", "$value": "1" },
      "title": { "$type": "letterSpacing", "$value": "0.6" },
      "none": { "$type": "letterSpacing", "$value": "0" }
    },
    "typography": {
      "site-name": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.site-name}", "fontWeight": "{font.weight.medium}", "lineHeight": "{line-height.compact}", "letterSpacing": "{letter-spacing.site-name}" } },
      "nav": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.nav}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line-height.compact}", "letterSpacing": "{letter-spacing.nav}" } },
      "label": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.label}", "fontWeight": "{font.weight.medium}", "lineHeight": "{line-height.compact}", "letterSpacing": "{letter-spacing.label}" } },
      "meta": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.meta}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line-height.compact}", "letterSpacing": "{letter-spacing.meta}" } },
      "page-title": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.3xl}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line-height.compact}", "letterSpacing": "{letter-spacing.title}" } },
      "article-title": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.4xl}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line-height.heading}", "letterSpacing": "{letter-spacing.title}" } },
      "card-title": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.xl}", "fontWeight": "{font.weight.medium}", "lineHeight": "{line-height.compact}", "letterSpacing": "{letter-spacing.none}" } },
      "row-title": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.lg}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line-height.normal}", "letterSpacing": "{letter-spacing.none}" } },
      "content-heading": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.2xl}", "fontWeight": "{font.weight.medium}", "lineHeight": "{line-height.compact}", "letterSpacing": "{letter-spacing.none}" } },
      "article-body": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.lg}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line-height.article}", "letterSpacing": "{letter-spacing.none}" } },
      "body": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.base}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line-height.article}", "letterSpacing": "{letter-spacing.none}" } },
      "excerpt": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.excerpt}", "fontWeight": "{font.weight.light}", "lineHeight": "{line-height.relaxed}", "letterSpacing": "{letter-spacing.none}" } },
      "small": { "$type": "typography", "$value": { "fontFamilies": "{font.family.sans}", "fontSizes": "{font.size.sm}", "fontWeight": "{font.weight.light}", "lineHeight": "{line-height.relaxed}", "letterSpacing": "{letter-spacing.none}" } },
      "code": { "$type": "typography", "$value": { "fontFamilies": "{font.family.mono}", "fontSizes": "{font.size.code}", "fontWeight": "{font.weight.regular}", "lineHeight": "{line-height.code}", "letterSpacing": "{letter-spacing.none}" } }
    },
    "space": {
      "2xs": { "$type": "spacing", "$value": "6" },
      "xs": { "$type": "spacing", "$value": "10" },
      "sm": { "$type": "spacing", "$value": "14" },
      "md": { "$type": "spacing", "$value": "18" },
      "lg": { "$type": "spacing", "$value": "26" },
      "xl": { "$type": "spacing", "$value": "40" },
      "2xl": { "$type": "spacing", "$value": "56" },
      "3xl": { "$type": "spacing", "$value": "72" },
      "4xl": { "$type": "spacing", "$value": "96" },
      "5xl": { "$type": "spacing", "$value": "120" }
    },
    "size": {
      "content": { "$type": "sizing", "$value": "720", "$description": "Width of the text column on reading pages" },
      "wide": { "$type": "sizing", "$value": "1120", "$description": "Width of the header, footer and two-column home" },
      "sidebar": { "$type": "sizing", "$value": "280", "$description": "Width of the home sidebar with profile and RSS" },
      "gutter": { "$type": "sizing", "$value": "40", "$description": "Side padding of the column on wide screens" },
      "icon-link": { "$type": "sizing", "$value": "16" }
    },
    "duration": {
      "fast": { "$type": "number", "$value": "150", "$description": "Hover of small controls (ms)" },
      "base": { "$type": "number", "$value": "200", "$description": "Hover of cards, titles and tags (ms)" },
      "slow": { "$type": "number", "$value": "300", "$description": "Hover of navigation links (ms)" },
      "enter": { "$type": "number", "$value": "600", "$description": "Entrance animation of a section (ms)" },
      "stagger": { "$type": "number", "$value": "80", "$description": "Delay between entering sections (ms)" }
    },
    "radius": {
      "card": { "$type": "borderRadius", "$value": "14" },
      "code": { "$type": "borderRadius", "$value": "10" },
      "full": { "$type": "borderRadius", "$value": "999" }
    }
  },
  "light": {
    "color": {
      "background-top": { "$type": "color", "$value": "#E8EDF0" },
      "background": { "$type": "color", "$value": "#F6F4EF" },
      "mist": { "$type": "color", "$value": "#FFFFFFB3" },
      "text": { "$type": "color", "$value": "#3D4651" },
      "text-secondary": { "$type": "color", "$value": "#5E6772" },
      "text-muted": { "$type": "color", "$value": "#666F7A" },
      "accent": { "$type": "color", "$value": "#2F5FC4" },
      "accent-soft": { "$type": "color", "$value": "#2F5FC459" },
      "border": { "$type": "color", "$value": "#DCE1E5" },
      "surface": { "$type": "color", "$value": "#FFFFFF9E" },
      "surface-hover": { "$type": "color", "$value": "#FFFFFFE6" },
      "chip": { "$type": "color", "$value": "#FFFFFF80" },
      "code-surface": { "$type": "color", "$value": "#3D46510F" },
      "shadow": { "$type": "color", "$value": "#3D465114" },
      "shadow-hover": { "$type": "color", "$value": "#3D46512E" },
      "accent-faint": { "$type": "color", "$value": "#2F5FC41F" },
      "syntax": {
        "keyword": { "$type": "color", "$value": "#2F5FC4" },
        "string": { "$type": "color", "$value": "#3B7A57" },
        "comment": { "$type": "color", "$value": "#6A727C" },
        "function": { "$type": "color", "$value": "#7B4DB3" },
        "constant": { "$type": "color", "$value": "#B25A2E" },
        "punctuation": { "$type": "color", "$value": "#6B7480" }
      },
      "diagram": {
        "node": { "$type": "color", "$value": "#FFFFFF" }
      }
    }
  },
  "dark": {
    "color": {
      "background-top": { "$type": "color", "$value": "#1B2129" },
      "background": { "$type": "color", "$value": "#12161B" },
      "mist": { "$type": "color", "$value": "#8FA9D61A" },
      "text": { "$type": "color", "$value": "#DCE1E6" },
      "text-secondary": { "$type": "color", "$value": "#9AA3AD" },
      "text-muted": { "$type": "color", "$value": "#7C8590" },
      "accent": { "$type": "color", "$value": "#7EA2F2" },
      "accent-soft": { "$type": "color", "$value": "#7EA2F266" },
      "border": { "$type": "color", "$value": "#2A313A" },
      "surface": { "$type": "color", "$value": "#FFFFFF0D" },
      "surface-hover": { "$type": "color", "$value": "#FFFFFF17" },
      "chip": { "$type": "color", "$value": "#FFFFFF0F" },
      "code-surface": { "$type": "color", "$value": "#FFFFFF0F" },
      "shadow": { "$type": "color", "$value": "#00000059" },
      "shadow-hover": { "$type": "color", "$value": "#00000080" },
      "accent-faint": { "$type": "color", "$value": "#7EA2F229" },
      "syntax": {
        "keyword": { "$type": "color", "$value": "#8FB0F5" },
        "string": { "$type": "color", "$value": "#8FCBA4" },
        "comment": { "$type": "color", "$value": "#8A939D" },
        "function": { "$type": "color", "$value": "#C1A5EE" },
        "constant": { "$type": "color", "$value": "#E6A77D" },
        "punctuation": { "$type": "color", "$value": "#9AA3AD" }
      },
      "diagram": {
        "node": { "$type": "color", "$value": "#232A33" }
      }
    }
  },
  "$themes": [
    { "name": "light", "group": "mode", "selectedTokenSets": { "base": "enabled", "light": "enabled" } },
    { "name": "dark", "group": "mode", "selectedTokenSets": { "base": "enabled", "dark": "enabled" } }
  ],
  "$metadata": { "tokenSetOrder": ["base", "light", "dark"] }
}
