{
  "name": "tanabe-blog-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "vite build",
    "dev": "npm run build:ui && wrangler dev --var ACCESS_BYPASS:true --var WRITE_HOST:127.0.0.1",
    "check": "npm run build:ui && npm run check:types && npm run test:unit && npm run test:e2e",
    "check:types": "tsc --noEmit && tsc --project tsconfig.ui.json && tsc --project tsconfig.e2e.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build:ui && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/markdown": "^1.8.1",
    "jose": "^6.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
